# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PHP files - WordPress Coding Standards
[*.php]
indent_style = tab
indent_size = 4

# JSON, YAML, and Markdown files
[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

# JavaScript and CSS files
[*.{js,css,scss,sass,less}]
indent_style = tab
indent_size = 4

# Package.json and composer.json
[{package.json,composer.json}]
indent_style = space
indent_size = 2

# Markdown files - don't trim trailing whitespace (needed for line breaks)
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 4

# XML and HTML files
[*.{xml,html}]
indent_style = tab
indent_size = 4
