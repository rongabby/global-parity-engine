{
    "name": "rongabby/global-parity-engine",
    "description": "A WordPress plugin suite for global parity data tracking and visualization with Google Earth integration",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "rongabby",
            "role": "Developer"
        }
    ],
    "keywords": [
        "wordpress",
        "plugin",
        "parity",
        "google-earth",
        "data-tracking",
        "geospatial"
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "GlobalParityEngine\\ParityData\\": "plugins/global-parity-data/src/",
            "GlobalParityEngine\\GoogleEarth\\": "plugins/google-earth-integration/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlobalParityEngine\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "phpcs --standard=WordPress --extensions=php plugins/",
        "lint:fix": "phpcbf --standard=WordPress --extensions=php plugins/",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf",
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env') && file_exists('.env.example')) { copy('.env.example', '.env'); echo 'Created .env file from .env.example\n'; }\""
        ],
        "setup-standards": [
            "phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/phpcompatibility-wp"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
